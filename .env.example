# Names only. Real values go in .env.local (never committed) and in Vercel.
# To start: copy this file, name the copy .env.local, and paste each value after its "=" (no quotes, no spaces).
# Where to find them: Supabase dashboard > your project > Project Settings > API Keys.

# "Project URL" (looks like https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (starts with sb_secret_). Never share it with anyone, including in a chat.
SUPABASE_SECRET_KEY=

# The live site address, e.g. https://empire-os.vercel.app (not secret). Used for links on
# posters, share images and the sitemap. Optional while developing.
NEXT_PUBLIC_SITE_URL=
